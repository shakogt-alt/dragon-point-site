# Confirmed HTTPS production origin only; no path, credentials, query or hash.
# Missing/invalid SITE_URL keeps indexing blocked and omits absolute SEO URLs.
SITE_URL=
# Explicit deployment environment for non-Vercel hosting:
# development | preview | staging | production. NODE_ENV does not enable indexing.
# On Vercel, VERCEL_ENV is detected automatically; preview always vetoes production.
SITE_ENV=development
# Optional approved absolute HTTPS image URL, actual dimensions must be 1200x630.
# Leave empty until final branded artwork is supplied. No placeholder image is emitted.
OG_IMAGE_URL=
# Optional server-only delivery destination. Leave blank until confirmed.
# HTTPS webhook must persist the lead before replying 2xx; redirects are rejected.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=
# Optional measurement readiness. Keep blank until IDs/configuration are approved.
# GA4 requires Analytics; Meta requires Marketing; GTM requires both categories.
# GTM replaces direct GA4, and requires an audited consent template/tag container.
# Disable vendor automatic form measurement/advanced matching before activation.
# Unsafe URL/query/referrer context blocks vendor loading; lead attribution is separate.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
