# Confirmed HTTPS production origin only; no path, credentials, query or hash.
# Missing/invalid SITE_URL keeps indexing blocked and omits absolute SEO URLs.
SITE_URL=
# Explicit deployment environment for non-Vercel hosting:
# development | preview | staging | production. NODE_ENV does not enable indexing.
# On Vercel, VERCEL_ENV is detected automatically; preview always vetoes production.
SITE_ENV=development
# Optional approved absolute HTTPS image URL, actual dimensions must be 1200x630.
# Leave empty until final branded artwork is supplied. No placeholder image is emitted.
OG_IMAGE_URL=
# Future phases: leave integrations disabled until configured and consent is implemented.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
